+# ─────────────────────────────────────────────────────────────────────────────
+# Queuei — environment template
+#
+# Copy this file to `.env` and fill in the values:  cp .env-example .env
+# Secrets and infrastructure config live here and are NEVER stored in the database.
+# The pipeline-behaviour values (playlist IDs, fetch limit, model, workers, sleep,
+# extra args) are only SEED defaults — once the Settings page (/settings/) runs,
+# the value stored in PostgreSQL takes precedence and can be edited live.
+#
+# Full docs: https://queueio.org/docs
+# ─────────────────────────────────────────────────────────────────────────────
+
+# ── Django ───────────────────────────────────────────────────────────────────
+DJANGO_SECRET_KEY=change-me-to-a-long-random-string
+ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
+DEBUG=False
+
+# ── PostgreSQL (Neon or any Postgres) ────────────────────────────────────────
+# Django ORM: users/auth, TaskConfiguration, GlobalSetting, CronJob,
+#             DashboardFeed, TranscriptCache
+DATABASE_URL=postgres://user:password@host/dbname
+
+# ── MongoDB Atlas ────────────────────────────────────────────────────────────
+# Content records, transcripts, LLM outputs, and 3072-dim embedding vectors.
+# The pipeline builds:  mongodb+srv://<DB_USER>:<DB_PASSWORD>@<DB_URL>/
+DB_USER=your-mongo-user
+DB_PASSWORD=your-mongo-password
+DB_URL=cluster0.xxxxx.mongodb.net
+MONGO_DB_NAME=queuei
+# Optional direct URI override (defaults to mongodb://localhost:27017/ if unset)
+MONGO_URI=
+
+# ── Google Gemini ────────────────────────────────────────────────────────────
+# Used for summarisation, embeddings, and server-side transcript fallback.
+GOOGLE_API_KEY=AIza...
+GEN_AI_API_KEY=AIza...
+
+# ── Pipeline defaults (seed values — editable later at /settings/) ───────────
+YOUTUBE_PLAYLIST_IDS=PLxxxxxx,PLyyyyyy
+PLAYLIST_FETCH_LIMIT=10
+AI_MODEL=gemini-3-flash-preview
+EXECUTOR_WORKERS=1
+INBETWEEN_TASK_SLEEP=15
+EXTRA_DOCUMENT_ARGS={}
+
+# ── Security ─────────────────────────────────────────────────────────────────
+# Required in production — sent as the X-Task-Secret header on scheduled/internal
+# endpoint jobs so only the scheduler can trigger them.
+TASK_SECRET=change-me-to-a-random-token
+# Set True when TLS is terminated by an upstream nginx / load balancer.
+SECURE_PROXY=False
+
+# ── Transcript fallbacks (optional) ──────────────────────────────────────────
+# The transcript chain is: youtube_transcript_api → Gemini → RapidAPI → Supadata.
+# Gemini covers cloud hosts where the library is IP-blocked, so these are optional.
+RAPID_API_KEY=
+RAPID_API_HOST=
+RAPID_API_URL=
+SUPADATA_API_KEY=
+
+# ── Alerts (optional) ────────────────────────────────────────────────────────
+SLACK_WEBHOOK_URL=
